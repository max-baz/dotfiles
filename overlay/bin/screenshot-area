#!/bin/sh

service=sway-inactive-windows-transparency.service
transparency_active=false
child=
directory=$(mktemp -d "${XDG_RUNTIME_DIR:?}/screenshot-area.XXXXXX") || exit 1

restore_transparency() {
    if "$transparency_active"; then
        systemctl --user start "$service" || return 1
        transparency_active=false
    fi
}

cleanup() {
    status=$?
    trap - EXIT
    if [ -n "$child" ]; then
        kill -TERM "$child" 2>/dev/null
        wait "$child" 2>/dev/null
    fi
    restore_transparency
    rm -f "$directory/area.png"
    rmdir "$directory"
    exit "$status"
}

trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP

if systemctl --user is-active --quiet "$service"; then
    transparency_active=true
    systemctl --user stop "$service" || exit 1
fi

wayfreeze --selector 'waysip -s "#ff3f3faf" -w 2 -d' --output "$directory/area.png" &
child=$!
wait "$child"
status=$?
child=
[ "$status" -eq 0 ] || exit "$status"

restore_transparency || exit 1
swappy -f "$directory/area.png"
